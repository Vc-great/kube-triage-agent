# Copy to .local/dev.env (0600). Only private values and optional connection overrides.
POSTGRES_PASSWORD=
DEMO_API_TOKEN=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Independent 32-256 character ASCII key, required by Memory modes.
INCIDENT_MEMORY_PROVENANCE_SECRET=
# Optional; omit when using the built-in dev01 defaults.
# DEV_SSH_HOST=dev01
# DEV_REMOTE_API_URL=http://192.168.31.110:12026
# Optional only for make dev-mock, dev-mock-window, dev-mock-summary.
# Cloud traces can include the complete synthetic prompt and model/tool output.
# LANGFUSE_TRACING_ENABLED=false
# LANGFUSE_ENV_FILE=/absolute/path/to/your/private/.env
# Keep the three LANGFUSE_* credentials in that private 0600 file, never here.
