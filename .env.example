# Copy to .env and set a unique, URL-safe password before starting.
POSTGRES_USER=kube_triage_agent
POSTGRES_DB=kube_triage_agent
POSTGRES_PASSWORD=
DEMO_API_TOKEN=
WEB_PORT=13002
API_PORT=12027
NEXT_PUBLIC_API_URL=http://localhost:12027
MCP_SERVER_URL=http://k8s-mcp:8080/mcp
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Gate A: optional deterministic context estimate; budget includes 2048 output reserve.
CONTEXT_WINDOW_ENABLED=false
CONTEXT_SUMMARY_ENABLED=false
CONTEXT_ESTIMATED_TOTAL_BUDGET=16384
# Incident Memory is a private single-user demo. READ and WRITE are independent;
# either enabled mode requires a distinct server-only 32–256 character HMAC secret.
INCIDENT_MEMORY_ENABLED=false
INCIDENT_MEMORY_READ_ENABLED=false
INCIDENT_MEMORY_WRITE_ENABLED=false
INCIDENT_MEMORY_PROVENANCE_SECRET=
INCIDENT_MEMORY_MAX_HITS=2
INCIDENT_MEMORY_MAX_CANDIDATES=20
REPAIR_ENABLED=false
REPAIR_MCP_SERVER_URL=
# Optional native-development connection overrides. The profile is selected by make dev-*.
# DEV_SSH_HOST=dev01
# DEV_REMOTE_API_URL=http://192.168.31.110:12026
# Valid keys auto-enable tracing for all API modes, including Compose.
# API model requests always use host port 7890: native 127.0.0.1, Compose host.docker.internal.
# Langfuse uses the same proxy when the three keys below enable tracing.
# Real and memory profiles can send Kubernetes or conversation data to Cloud.
# Keep credentials in this private 0600 file; never commit actual values.
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
